{
	http_port 8080
	auto_https off

	servers {
		# Matches upstream's Caddyfile as of v5.3.0, added there alongside the new
		# /api/v1 activity upload. Caddy has no read-body timeout by default, so an
		# open POST that trickles bytes holds a connection (and a FrankenPHP worker,
		# of which we run two) indefinitely. 60s is enough for a FIT file over a slow
		# link and bounds a stalled or hostile upload.
		timeouts {
			read_body 60s
		}
	}

	frankenphp {
		num_threads 3
		worker {
			num 2
			file ./public/index.php
		}
	}

	log {
		output stdout
		format console
		level {$CADDY_LOG_LEVEL:ERROR}
	}
}

# The shared site config: everything that is identical on both listeners below.
# Kept in a snippet so the ingress listener and the published listener can never
# drift apart — the only difference between them is how forwarded headers are
# handled, which is the point of having two.
(app) {
	root /var/www/public
	encode zstd br gzip

	# Lightweight health endpoint for HA watchdog checks.
	handle /healthz {
		rewrite * /healthz.php
		php
	}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header {
		Cache-Control "no-cache, no-store, must-revalidate"
		?Permissions-Policy "browsing-topics=()"
	}

	# Static frontend resources ship inside the image under /var/www/public.
	#
	# There is deliberately no handler for /data/build/html here: v5.2.0 dropped
	# pre-built HTML entirely and renders every page (including "/") and every
	# fragment through Symfony, so anything not matched below must fall through to
	# the front controller at the bottom of this file.

	# Every URL under /css, /js and /libraries carries a ?v<app-version> query:
	# the stylesheet and library tags are rendered with it, and app.min.js wraps
	# webpack's chunk URL builder to append it to lazy chunks too. So they are
	# safe to cache and self-bust on an upstream bump.
	#
	# Upstream sends "no-cache, no-store, must-revalidate" for everything except
	# /files/*, which means a full page load refetches the ~176kB tailwind bundle
	# before it can style anything. The browser paints the unstyled shell in the
	# meantime — most visibly the logo, an SVG sized only by a Tailwind class, at
	# its intrinsic size. That is the flash when returning to the app from /admin,
	# which is a full page load rather than an SPA navigation.
	@versionedStatic path /css/* /js/* /libraries/*
	handle @versionedStatic {
		header {
			Cache-Control "public, max-age=86400"
		}
		root * /var/www/public
		file_server
	}

	# Cache and serve static assets from Symfony public dir.
	handle /assets/* {
		header {
			Cache-Control "public, max-age=86400"
		}
		root * /var/www/public
		file_server
	}

	# Serve badge SVGs - no cache
	@badges path /files/*-badge.svg
	handle @badges {
		header {
			Cache-Control "no-cache, no-store, must-revalidate"
		}

		root * /data/storage
		file_server
	}

	# Serve other /files/* from storage
	handle /files/* {
		header {
			Cache-Control "public, max-age=31536000, immutable"
		}

		root * /data/storage
		file_server
	}

	# Serve /gear-maintenance/* from storage.
	handle /gear-maintenance/* {
		root * /data/storage
		file_server
	}

	# Serve everything else through Symfony.
	handle {
		@phpRoute {
			not file {path}
		}

		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController
	}

	# Handle error codes.
	handle_errors 403 404 {
		root /var/www/public
		rewrite * /{err.status_code}.html
		file_server
	}

	handle_errors 5xx {
		root /var/www/public
		rewrite * /50x.html
		file_server
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}

	# Hide php and yaml file from filesystem
	file_server {
		hide *.php *.yaml *.yml
	}
}

# Forwarded headers a client sent us on the PUBLISHED port. Stripped by default:
# Symfony trusts any private-range peer (see config/packages/zz-ha-ingress.yaml),
# and a LAN client reaching :8080 directly is exactly that, so without this it can
# assert whatever it likes — a spoofed X-Forwarded-Host redirects the admin login
# to an attacker's host, and a spoofed X-Forwarded-For walks past ADMIN_ALLOWED_IPS.
(strip_forwarded) {
	request_header -X-Forwarded-For
	request_header -X-Forwarded-Host
	request_header -X-Forwarded-Proto
	request_header -X-Forwarded-Port
}

# The opt-in counterpart (trust_forwarded_headers: true), for when the port sits
# behind the user's own reverse proxy terminating TLS: the headers are left alone
# so redirects keep the external scheme and host. X-Forwarded-Prefix and
# X-Ingress-Path are stripped in the site block either way — they are the ingress
# contract, and nothing outside may claim it.
(trust_forwarded) {
	request_header -X-Ingress-Path
}

# INGRESS LISTENER — reachable only by the Home Assistant supervisor. It is named
# by `ingress_port` in config.yaml and is deliberately NOT in `ports`, so nothing
# outside the supervisor can open a connection to it. That is what makes the
# X-Ingress-Path handling below safe to trust: a request arriving here came from
# the supervisor, no header inspection required.
#
# Before the listeners were split, this ran on the published :8080 and the guard
# was "no X-Ingress-Path header means strip X-Forwarded-Prefix" — which any client
# could sidestep by simply sending X-Ingress-Path itself and choosing its own base
# path. The trust boundary is the socket now, not the header.
:8099 {
	# The supervisor proxy strips the /api/hassio_ingress/<token> prefix and
	# forwards it as X-Ingress-Path. Map it to X-Forwarded-Prefix so Symfony (which
	# trusts the private-range proxy, see config/packages/zz-ha-ingress.yaml)
	# generates redirects and router/asset URLs under the ingress base path.
	#
	# The two matchers are mutually exclusive so their order never conflicts — a
	# single unconditional strip plus a conditional set would not work, because
	# Caddy's headers handler applies deletions after sets and would clobber our
	# value on legit ingress requests.
	@noIngressPath not header X-Ingress-Path *
	request_header @noIngressPath -X-Forwarded-Prefix
	@hasIngressPath header X-Ingress-Path *
	request_header @hasIngressPath X-Forwarded-Prefix {header.X-Ingress-Path}

	import app
}

# PUBLISHED LISTENER — the optional 8080/tcp port, plus the HA watchdog's
# /healthz check. Never ingress: the prefix headers are stripped unconditionally,
# and the remaining X-Forwarded-* ones according to the trust_forwarded_headers
# option (start.sh resolves it into SFS_FORWARDED_MODE; absent means strip).
:8080 {
	request_header -X-Ingress-Path
	request_header -X-Forwarded-Prefix
	import {$SFS_FORWARDED_MODE:strip_forwarded}

	import app
}
