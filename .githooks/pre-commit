#!/usr/bin/env sh
set -eu

CHECK_SCRIPT="scripts/check-release-consistency.sh"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  exit 0
fi

if [ ! -x "$CHECK_SCRIPT" ]; then
  echo "pre-commit: missing executable ${CHECK_SCRIPT}" >&2
  exit 1
fi

for config_path in */config.yaml; do
  [ -f "$config_path" ] || continue
  addon="$(dirname "$config_path")"
  changelog_path="${addon}/CHANGELOG.md"

  staged_in_addon="$(git diff --cached --name-only --diff-filter=ACMRD -- "$addon" || true)"
  [ -n "$staged_in_addon" ] || continue

  staged_config="$(git diff --cached --name-only --diff-filter=ACMRD -- "$config_path" || true)"
  staged_changelog="$(git diff --cached --name-only --diff-filter=ACMRD -- "$changelog_path" || true)"

  if [ -z "$staged_config" ] || [ -z "$staged_changelog" ]; then
    echo "pre-commit: ${addon} changed; stage a version bump in ${config_path} and ${changelog_path}" >&2
    exit 1
  fi
done

"$CHECK_SCRIPT" --staged --require-bump

# Also verify every add-on's pin: check-release-consistency.sh compares config.yaml against
# CHANGELOG.md and never looks at ARG BUILD_FROM, so a Dockerfile disagreeing with .upstream-version
# would otherwise sail through. Working tree rather than index, which is what actually gets built.
SYNC_SCRIPT="scripts/bump-upstream.sh"
if [ ! -x "$SYNC_SCRIPT" ]; then
  echo "pre-commit: missing executable ${SYNC_SCRIPT}" >&2
  exit 1
fi

exec "$SYNC_SCRIPT" check
